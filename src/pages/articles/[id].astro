---
import {getCollection,render} from 'astro:content'; import ArticleLayout from '../../layouts/ArticleLayout.astro';
export async function getStaticPaths(){return (await getCollection('posts',({data})=>!data.draft)).map(post=>({params:{id:post.id},props:{post}}));}
const {post}=Astro.props; const {Content}=await render(post);
---
<ArticleLayout title={post.data.title} date={post.data.date} description={post.data.description} tags={post.data.tags}><Content/></ArticleLayout>
