---
import BaseLayout from './BaseLayout.astro';
const {title,date,description,tags=[],eyebrow='ARTICLE'}=Astro.props;
---
<BaseLayout title={title} description={description}><article class="article"><header><div class="kicker">{eyebrow}</div><h1>{title}</h1>{date&&<time>{date.toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'})}</time>}{tags.length>0&&<div class="tags">{tags.map((tag:string)=><a href={'/tags/'+tag.toLowerCase()+'/'}>#{tag}</a>)}</div>}</header><div class="prose"><slot/></div></article></BaseLayout>
